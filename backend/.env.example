# Server
PORT=3000
DB_PATH=/app/data/financelab.db

# Outlook / Microsoft 365 SMTP
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-mailbox@yourdomain.com
SMTP_PASS=your-app-password
SMTP_FROM=your-mailbox@yourdomain.com
# Comma-separate multiple recipients, e.g.: financelab@iba.edu.pk, coordinator@iba.edu.pk
NOTIFY_TO=financelab@iba.edu.pk

# Admin dashboard
ADMIN_USERNAME=admin
# Generate with: npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=
# Generate a random 32+ byte secret, e.g.: openssl rand -hex 32
SESSION_SECRET=
